# Staging: /etc/vbi-hr/bitrix.env (или bitrix-staging.env)
# Приложение отдельно от боя; redirect на :8080

BITRIX_PORTAL_URL=https://crm.vbi.ru
BITRIX_CLIENT_ID=local.xxxxx
BITRIX_CLIENT_SECRET=xxxxx
BITRIX_REDIRECT_URI=http://45.12.74.25:8080/api/auth/bitrix/callback
APP_PUBLIC_URL=http://45.12.74.25:8080
BITRIX_WEBHOOK_URL=https://crm.vbi.ru/rest/ID/СЕКРЕТ/
# График отсутствий → «отпуск ежегодный» (пальма в Битриксе). Если не задан — попытка найти по имени «График отсутствий»
# BITRIX_ABSENCE_IBLOCK_ID=12
# BITRIX_ABSENCE_IBLOCK_TYPE_ID=structure
# BITRIX_ABSENCE_TYPE_ENUM=1
BITRIX_ADMIN_GROUP_IDS=1
BITRIX_HR_GROUP_IDS=
BITRIX_MANAGER_GROUP_IDS=
# База знаний — Yandex GPT:
# YANDEX_GPT_FOLDER_ID=b1g...
# YANDEX_GPT_API_KEY=AQVN...
# YANDEX_GPT_MODEL_URI=gpt://b1g.../yandexgpt-lite
# Эмбеддинги для поиска по смыслу (по умолчанию emb://<folder>/text-search-doc|query/latest)
# YANDEX_EMBED_DOC_URI=emb://b1g.../text-search-doc/latest
# BITRIX_PASSWORD_LOGIN=0
# Код ChatGPT (/vpn): IMAP к корпоративной почте
# EMAIL_LOGIN=
# EMAIL_PASSWORD=
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# Коды ChatGPT → Telegram-канал (параллельно /vpn). docs/CHATGPT-TELEGRAM.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CHANNEL_ID=
# CRON_SECRET=change-me
