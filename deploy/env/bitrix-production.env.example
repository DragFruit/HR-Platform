# Бой: /etc/vbi-hr/bitrix-production.env
# Приложение «VBI HR Platform» — обработчик http://45.12.74.25/api/auth/bitrix/callback

BITRIX_PORTAL_URL=https://crm.vbi.ru
BITRIX_CLIENT_ID=local.xxxxx
BITRIX_CLIENT_SECRET=xxxxx
# HMAC для cookie-сессий (обязательно свой на бою; не коммитить)
VBI_SESSION_SECRET=сгенерируйте-длинную-случайную-строку
BITRIX_REDIRECT_URI=http://45.12.74.25/api/auth/bitrix/callback
APP_PUBLIC_URL=http://45.12.74.25
# URL с секретом — только на сервере, не в git / не в тикеты
BITRIX_WEBHOOK_URL=https://crm.vbi.ru/rest/ID/СЕКРЕТ/
# Опционально: refresh_token для im.notify (иначе сохраняется при входе админа через OAuth)
# BITRIX_SERVICE_REFRESH_TOKEN=
# Типизированный колокольчик (VBI HR → Заявки на отпуск), без «Неопознанные»:
# BITRIX_VACATION_NOTIFY_BRIDGE_URL=https://crm.vbi.ru/local/vbi-hr/vacation-notify.php
# BITRIX_VACATION_NOTIFY_BRIDGE_SECRET=
# Согласование отпусков — только im.notify.system.add (чат im.message.add не используем)
BITRIX_ADMIN_GROUP_IDS=1
BITRIX_HR_GROUP_IDS=
BITRIX_MANAGER_GROUP_IDS=
# VPN wg-easy (пароли только на сервере, не в git)
# WG_EASY_URL=http://188.190.10.62:51831
# WG_EASY_PASSWORD=
# AWG_EASY_URL=http://188.190.10.62:51821
# AWG_EASY_PASSWORD=
