# Бой: скопируйте в sites-enabled и замените server_name + SSL при необходимости.
server {
    listen 80;
    server_name 45.12.74.25 hr.example.com;

    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Карта кликов / Вебвизор: сайт открывается в iframe на metrika.yandex.*
        # https://yandex.ru/support/metrica/ru/behavior/click-map#iframe
        add_header Content-Security-Policy "frame-ancestors 'self' https://metrika.yandex.ru https://metrika.yandex.by https://metrika.yandex.com https://metrika.yandex.com.tr https://metrica.yandex.ru https://metrica.yandex.by https://metrica.yandex.com https://webvisor.com https://*.webvisor.com https://*.metrika.yandex.ru https://*.metrika.yandex.by" always;
    }
}
