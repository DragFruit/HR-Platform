# Скопируйте в frontend/.env (файл в gitignore, сюда не коммитить секреты)
#
# ВАЖНО: CLIENT_ID и SECRET — из ОТДЕЛЬНОГО приложения «VBI HR (dev)» в Битриксе.
# Не копируйте ключи с сервера 45.12.74.25 — иначе OAuth уйдёт на прод и будет «Неверный state».
#
BITRIX_PORTAL_URL=https://crm.vbi.ru
BITRIX_CLIENT_ID=local.xxxxx
BITRIX_CLIENT_SECRET=xxxxx
# При npm run dev callback берётся с текущего порта (обычно 3000). Тот же URL — в «Путь обработчика» в Битриксе.
BITRIX_REDIRECT_URI=http://localhost:3000/api/auth/bitrix/callback
# Опционально на Mac: синк сотрудников и im.notify при отпусках (нужно право im).
# BITRIX_WEBHOOK_URL=https://crm.vbi.ru/rest/ID/СЕКРЕТ/
# APP_PUBLIC_URL=http://localhost:3000
BITRIX_ADMIN_GROUP_IDS=1
BITRIX_HR_GROUP_IDS=
BITRIX_MANAGER_GROUP_IDS=
# NUXT_PUBLIC_QA_TEST_DEPARTMENT=1
# QA-отдел «Тестировщики» (демо-аккаунты Маша/Костя/Катя). На production не задавать или =0.
# Локально как на проде (только отпуска): NUXT_PUBLIC_LAUNCH_SCOPE=vacations
# Быстрый старт: npm run dev:vacations  →  http://localhost:3000/vacations
# NUXT_PUBLIC_YANDEX_METRIKA_ID=110244372
