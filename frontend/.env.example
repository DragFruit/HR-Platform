# Скопируйте в .env и при необходимости измените:
#   cp .env.example .env

# Окружение: development | staging | production
# staging — на тестовом стенде показывается плашка «Тестовый стенд»
NUXT_PUBLIC_APP_ENV=development

# full — все разделы платформы; vacations — только график отпусков (пилот)
NUXT_PUBLIC_LAUNCH_SCOPE=full

# Порт production-сервера (локально / на VPS)
# NITRO_PORT=3300
# NITRO_HOST=127.0.0.1
