# Скопируйте в .env для локальной разработки (файл .env не коммитится).

# development | staging | production
NUXT_PUBLIC_APP_ENV=development

# full — вся платформа; vacations — только график отпусков
NUXT_PUBLIC_LAUNCH_SCOPE=full

# Опционально: ссылки в футере
# NUXT_PUBLIC_SOCIAL_VK_URL=https://vk.com/vbi.agency
# NUXT_PUBLIC_SOCIAL_TELEGRAM_URL=https://t.me/vbi_agency

# Локальный запуск собранного приложения (не для Nuxt build)
# NITRO_PORT=3300
# NITRO_HOST=127.0.0.1
